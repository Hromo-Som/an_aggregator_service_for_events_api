APP_NAME=Events Aggregator
DEBUG=true
PORT=8000

EVENTS_PROVIDER_BASE_URL=http://example-provider.ru
EVENTS_PROVIDER_API_KEY=example_api_key
EVENTS_PROVIDER_TIMEOUT=10.0
EVENTS_PROVIDER_MAX_RETRIES=3

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/events
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

HTTP_TIMEOUT=10.0

SYNC_ENABLED=true
SYNC_HOUR=3
SYNC_BATCH_SIZE=200

CAPASHINO_BASE_URL=http://example-capashino-url.ru
CAPASHINO_API_KEY=example_api_key
CAPASHINO_TIMEOUT=10.0

OUTBOX_POLL_INTERVAL=5.0
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=5

SENTRY_DSN=https://example-dsn@glitchtip.python-labs.ru/42
ENVIRONMENT=development
RELEASE=dev
SENTRY_TRACES_SAMPLE_RATE=0.0